# ── Django Core ────────────────────────────────────────────────
SECRET_KEY=tu-secret-key-aqui
DEBUG=True

# ── Hosts y Seguridad ─────────────────────────────────────────
ALLOWED_HOSTS=127.0.0.1,localhost,.onrender.com
CSRF_TRUSTED_ORIGINS=https://gastu.onrender.com

# ── Base de Datos ──────────────────────────────────────────────
USE_SQLITE=True
# Supabase / PostgreSQL — se activa cuando USE_SQLITE=False
DATABASE_URL=postgresql://usuario:password@host:6543/postgres

# ── WebSockets / Redis (Django Channels) ───────────────────────
# En desarrollo se puede omitir para usar InMemoryChannelLayer.
# En producción (Oracle Cloud / Render), especificar la URL del servidor Redis:
REDIS_URL=redis://127.0.0.1:6379/0

# ── Agente Financiero (Groq) ───────────────────────────────────
GROQ_API_KEY=tu_api_key_de_groq_aqui

# ── Correo SMTP (Gmail) ────────────────────────────────────────
EMAIL_HOST_USER=tu_correo_de_soporte@gmail.com
EMAIL_HOST_PASSWORD=tu_contrasena_de_aplicacion_aqui

# ── Google OAuth ───────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=tu_client_id_de_google_aqui
GOOGLE_OAUTH_CLIENT_SECRET=tu_client_secret_de_google_aqui

# ── Superusuario Inicial (build.sh) ───────────────────────────
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@gastuapp.com
DJANGO_SUPERUSER_PASSWORD=Admin123!

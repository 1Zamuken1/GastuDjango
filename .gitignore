# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Bytecode — evita conflictos en pull/merge del equipo
**/__pycache__/
**/*.pyc
**/*.pyo

# Entorno virtual
.venv/
venv/

# Dependencias de Node (Tailwind build)
node_modules/
theme/static_src/node_modules/

# Archivos de entorno
.env

# Base de datos local (cada dev tiene la suya)
*.sqlite3

# Archivos de sistema
.DS_Store
Thumbs.db

# CSS/JS compilados de node_modules (no del proyecto)
# El CSS compilado de Tailwind (theme/static/css/dist/) SÍ se incluye en el repo
# para que el equipo pueda levantar el proyecto sin necesidad de correr npm.
# Si se modifica el CSS, regenerar con: cd theme/static_src && npm run build

# Imágenes externas (librerías de terceros — como las de .venv)
.venv/**/*.png
.venv/**/*.jpg
.venv/**/*.jpeg

# Archivos binarios / documentos generados por el usuario
*.xlsx
*.xls
*.pdf

# Capturas de pruebas automatizadas
capturas_pruebas/

# Scripts personales de prueba (no van al repo)
seed_meses_anteriores.py